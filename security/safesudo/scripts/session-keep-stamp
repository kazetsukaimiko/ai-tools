#!/usr/bin/env bash
# Record a short-lived session keep for the user who invoked pkexec (PKEXEC_UID).
# Must run as root (via pkexec). Safe to call at the start of every elevated batch.
set -euo pipefail

KEEP_SECONDS="${SAFESUDO_KEEP_SECONDS:-300}"
STAMP_DIR="${SAFESUDO_STAMP_DIR:-/run/safesudo-session-keep}"

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  echo "session-keep-stamp: must run as root (use: pkexec $0)" >&2
  exit 1
fi

uid="${PKEXEC_UID:-}"
if [[ -z "$uid" || "$uid" == "0" ]]; then
  echo "session-keep-stamp: PKEXEC_UID missing or root; refuse to stamp" >&2
  exit 1
fi

mkdir -p "$STAMP_DIR"
chmod 755 "$STAMP_DIR"
expiry=$(($(date +%s) + KEEP_SECONDS))
# atomic replace
tmp="$(mktemp "$STAMP_DIR/.tmp.XXXXXX")"
printf '%s\n' "$expiry" >"$tmp"
chmod 644 "$tmp"
mv -f "$tmp" "$STAMP_DIR/$uid"
